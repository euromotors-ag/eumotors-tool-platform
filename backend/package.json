{
  "name": "image-editor-backend",
  "description": "Express Node server for Image Editor",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc && tsc-alias && node copy-assets.js",
    "postinstall": "npx playwright install --with-deps",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.797.0",
    "@clerk/backend": "^3.22.0",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-validator": "^7.2.1",
    "file-type": "^20.4.1",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.2",
    "playwright": "^1.49.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "tsc-alias": "^1.8.15",
    "tsx": "^4.21.0",
    "typescript": "~5.7.2"
