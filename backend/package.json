{
  "name": "image-editor-backend",
  "description": "Express Node server for Image Editor",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch index.ts",
    "build": "prisma generate && tsc && tsc-alias && node copy-assets.js",
    "postinstall": "prisma generate && npx playwright install --with-deps",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx scripts/seed-all-enums.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.797.0",
    "@clerk/express": "^1.7.37",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@tanstack/react-query": "^5.90.16",
    "axios": "^1.12.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-validator": "^7.2.1",
    "file-type": "^20.4.1",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.2",
    "path-to-regexp": "^6.2.1",
    "pg": "^8.13.1",
    "playwright": "^1.49.0",
    "prisma": "^7.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/pg": "^8.16.0",
    "tsc-alias": "^1.8.15",
    "tsx": "^4.21.0",
    "typescript": "~5.7.2"
  }
}
