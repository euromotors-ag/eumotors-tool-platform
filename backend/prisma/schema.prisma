// Junction table för many-to-many relation mellan Car och Equipment
// Används för avancerad filtrering och sökning i marketplace
model CarEquipment {
  id          String    @id @default(uuid())
  carId       String    @map("car_id")
  equipmentId String    @map("equipment_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  
  car         Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([carId, equipmentId]) // En bil kan inte ha samma equipment två gånger
  @@index([carId])
  @@index([equipmentId])
}

model CarEnum {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  enumType  CarEnumType
  parentId  String?  @db.VarChar(255) // För MODEL_OPTIONS (brand -> models)
  source    String?  @default("enum") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name, enumType, parentId])
  @@index([enumType])
  @@index([parentId])
}

enum EquipmentBin {
  bin_good
  bin_trash
}

enum CarEnumType {
  body_type
  fuel_type
  drive_type
  transmission_type
  color
  interior_material
  brand
  model
  energy_efficiency
  euro_norm
  currency
}